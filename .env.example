# Bot credentials
TOKEN=your_main_bot_token
DEBUG_TOKEN=your_debug_bot_token

# PostgreSQL database
# For Docker, DB_HOST should be 'db'
DB_HOST=db
DB_PASSWORD=your_secure_database_password
DB_PORT=5432
DB_NAME=fm01

# Backend API (services/api) - the bot reaches its data through it
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_INTERNAL_TOKEN=your_secure_internal_api_token
# For Docker, API_URL should be 'http://api:8000'
# Otherwise 'http://localhost:8000'
API_URL=http://api:8000

# Dashboard sign-in (Discord OAuth2) - optional; leave unset to run without the dashboard.
# The client ID and secret are on your application's OAuth2 page in the Discord developer portal.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENCRYPTION_KEY=

# Lavalink (for music playback)
# For Docker, LAVALINK_URI should be 'http://lavalink:2333'
# Otherwise 'http://localhost:2333'
LAVALINK_URI=http://lavalink:2333
LAVALINK_PASSWORD=your_secure_lavalink_password

# Sentry - completely optional, we use it
# to see error messages on a dashboard
SENTRY_DSN=sentry_sdk_dsn

# RSSHub (TikTok alerts)
# For Docker, RSSHUB_URL should be 'http://rsshub:1200'
# Otherwise 'http://localhost:1200'
RSSHUB_URL=http://rsshub:1200

# cobalt (download command) - the self-hosted instance in compose.yml, reachable only from the Compose network.
# For Docker, COBALT_URL should be 'http://cobalt:9000'
# Otherwise wherever your instance runs. Leave unset to disable the download command.
COBALT_URL=http://cobalt:9000
# Only if your instance requires API keys (API_AUTH_REQUIRED=1).
# COBALT_API_KEY=

# Twitch (live stream alerts) - create an app at https://dev.twitch.tv/console/apps
# Leave unset to disable Twitch alerts.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Clustering - for production
# It's not recommended to mess with these values when self-hosting.
BOT_MODE=standalone  # or "clustered"
# If you use BOT_MODE=standalone, settings below will be ignored.
# SHARD_COUNT=64   # A shard usually contains 1000 servers; required with DISCORD_GATEWAY_URL
SHARDS_PER_CLUSTER=16  # One cluster (process) runs one block of 16 consecutive shards; the status page groups shards the same way
# Bot replicas * SHARDS_PER_CLUSTER must be >= SHARD_COUNT, or the leftover shards' servers get no responses.
# CLUSTER_ID=cluster-0  # Leave unset for automatic cluster ID assignment per replica
REDIS_URL=redis://redis:6379/0
REDIS_MSG_URL=redis://redis:6379/1
# DISCORD_PROXY_URL=http://twilight-proxy:3000/api/v10

# Gateway proxy - for production deployments that restart without reconnecting to Discord.
# Leave unset to connect to Discord directly (self-hosting, debug bot).
# COMPOSE_PROFILES=gateway-proxy
# DISCORD_GATEWAY_URL=ws://gateway-proxy:7878
