  "bot-locale": {
    "warn": {
      "embed": {
        "description": "Warned {warn.user.mention}.",
        "fields": [
          {
            "name": "Reason",
            "value": "{warn.reason}"
          },
          {
            "name": "Expires",
            "value": "{warn.length}"
          }
        ],
        "footer": {
          "text": "{warn.id}"
        },
        "title": "Warn"
      }
    },
    "giveaway": {
      "embed": {
        "description": "{prize}",
        "fields": [
          {
            "inline": true,
            "name": "Winners",
            "value": "{winners}"
          },
          {
            "inline": true,
            "name": "Ends",
            "value": "{ends}"
          }
        ],
        "footer": {
          "text": "Click the button below to enter!"
        },
        "title": "🎉 Giveaway!",
        "buttons": [
          {
            "label": "🎉 {participants}"
          }
        ]
      }
    },
    "work": {
      "embed": {
        "color": 6656243,
        "description": "{random}",
        "title": "Work"
      },
      "random": [
        "You arrived home from work and saw that **${amount}** was added to your account.",
        "You've reached the end of a tiring day. You received **${amount}** for your hard work!",
        "You've successfully completed your first day at work. Your reward: **${amount}**.",
        "You've been promoted at your company, so you received a **${amount}** bonus!",
        "You received **${amount}** dividend on your shares.",
        "You've been successfully promoted at your workplace! You received an advance of **${amount}**",
        "As a taxi driver, you earned **${amount}** today.",
        "You went to the store, bought noodles, but the cashier gave you the wrong change. You received **${amount}** and a pack of noodles.",
        "You had a hard day on the fields and earned **${amount}**."
      ]
    },
    "music": {
      "embed": {
        "color": 5793266,
        "description": "**[{track.title}]({track.url})**",
        "fields": [
          {
            "inline": true,
            "name": "Artist",
            "value": "{track.author}"
          },
          {
            "inline": true,
            "name": "Duration",
            "value": "{track.duration}"
          },
          {
            "inline": true,
            "name": "Position in queue",
            "value": "Now"
          }
        ],
        "footer": {
          "icon_url": "{author.avatar}",
          "text": "{author.name}"
        },
        "title": "Now playing"
      }
    },
    "info": {
      "user": {
        "author": {
          "icon_url": "{member.avatar}",
