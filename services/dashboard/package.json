{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "schemas": "uv run --directory ../api python -m app.openapi ../../shared/schemas/openapi/openapi.json && openapi-typescript ../../shared/schemas/openapi/openapi.json -o ../../shared/schemas/ts/api.d.ts",
    "dev": "pnpm schemas && next dev",
    "build": "pnpm schemas && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
